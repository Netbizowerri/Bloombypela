# ==============================================================================
# Bloom by Pela - Environment Variables Specification (.env.example)
# Note: Keep secrets strictly server-side (Cloud Functions / Secret Manager).
# Only VITE_ prefixed variables are bundled into the client application.
# ==============================================================================

# Client-Side Firebase Configuration (Public web credentials from Firebase Console)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="bloombypela.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bloombypela"
VITE_FIREBASE_STORAGE_BUCKET="bloombypela.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Stripe Client Configuration
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Application Public Host URL
VITE_APP_URL="https://bloombypela.com"

# ------------------------------------------------------------------------------
# Server-Side Only / Cloud Functions & Cloud Run Secrets (DO NOT prefix with VITE_)
# Stored securely in Google Cloud Secret Manager for Firebase Functions 2nd Gen
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RESEND_API_KEY="re_..."
POSTMARK_SERVER_TOKEN=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://bloombypela.com"
