# ==============================================================================
# Bloom by Pela - Environment Variables Specification (.env.example)
# Note: Keep secrets strictly server-side (Cloud Functions / Secret Manager).
# Only VITE_ prefixed variables are bundled into the client application.
# ==============================================================================

# Client-Side Firebase Configuration (Public web credentials from Firebase Console)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="bloombypela.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bloombypela"
VITE_FIREBASE_STORAGE_BUCKET="bloombypela.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Stripe Client Configuration
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Application Public Host URL
VITE_APP_URL="https://bloombypela.com"

# Local development only: connect to the Firebase Emulator Suite.
# Keep this "false" in production builds. Never enable it on the live site.
VITE_USE_EMULATORS="false"

# ------------------------------------------------------------------------------
# Server-Side Only / Cloud Functions & Cloud Run Secrets (DO NOT prefix with VITE_)
# Stored securely in Google Cloud Secret Manager for Firebase Functions 2nd Gen
# Set with: firebase functions:secrets:set <NAME>
# Emulator: put these in functions/.secret.local (git-ignored), never in .env
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RESEND_API_KEY="re_..."
POSTMARK_SERVER_TOKEN=""
APP_URL="https://bloombypela.com"

# Cloudinary (product images; direct unsigned uploads from the browser)
# No Firebase secrets or Cloud Functions are needed for this flow on the free Spark plan.
#
# Setup (one-time, in the Cloudinary dashboard):
#   1. Settings -> Upload -> Upload presets -> Add upload preset
#   2. Signing mode: Unsigned
#   3. Folder: bloom-by-pela/products   (optional but recommended)
#   4. Copy the preset ID and set VITE_CLOUDINARY_UPLOAD_PRESET below
#
# Public values only — safe to commit as an example. No API secret is used.
VITE_CLOUDINARY_CLOUD_NAME="titznrnk"
VITE_CLOUDINARY_UPLOAD_PRESET=""
