{
  "name": "bloom-by-pela-functions",
  "private": true,
  "version": "0.0.0",
  "description": "Cloud Functions (2nd gen) for Bloom by Pela",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test:rules": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.0",
    "firebase": "^13.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
