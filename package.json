{
  "name": "bloom-by-pela",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:functions": "npm --prefix functions run build",
    "preview": "vite preview",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "dev:admin": "tsx scripts/dev-admin.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit && npm --prefix functions run lint",
    "emulators": "npm run build:functions && firebase emulators:start --only auth,firestore,functions,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"npm --prefix functions run test:rules\"",
    "set-role": "tsx scripts/set-role.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
